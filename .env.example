# --- MQTT Configuration ---
MQTT_BROKER_HOST=your_mqtt_broker_address
MQTT_BROKER_PORT=1883 # Use 8883 for TLS typically
MQTT_USERNAME=your_mqtt_username # Optional
MQTT_PASSWORD=your_mqtt_password # Optional
MQTT_CLIENT_ID=AkitaMeshtasticTeamsBot-Default # Unique MQTT client ID for this bot instance
MQTT_BASE_TOPIC=msh/2/json # Adjust region/encoding if needed. No trailing slash.
MQTT_USE_TLS=False # Set to True if using TLS/SSL for MQTT
MQTT_PRIMARY_CHANNEL_NAME=LongFast # Meshtastic channel for sending Teams->Mesh messages

# --- Microsoft Teams Bot Configuration ---
TEAMS_APP_ID=your_microsoft_app_id_from_azure
TEAMS_APP_PASSWORD=your_microsoft_app_password_from_azure

# --- Bot Operation ---
# Required: NodeID (hex, starting with !) of the Meshtastic node acting as MQTT gateway
MESH_GATEWAY_NODE_ID=!your_gateway_node_hex_id # e.g., !a1b2c3d4

# Optional: Target conversation ID to send Meshtastic messages TO.
# If empty, bot needs to be messaged first in the target channel.
# Use the '@BotName bot info' command to find the ID for a specific channel/chat.
TEAMS_TARGET_CONVERSATION_ID=

# Optional: Path to a JSON file containing node aliases (e.g., {"!abcdef12": "Base Station"})
# NODE_ALIAS_FILE_PATH=node_aliases.json

# Web Server Port
PORT=3978

